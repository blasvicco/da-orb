      ],
      "id": "4d81a54c-9119-44cf-ac6e-f01164b97780",
      "name": "Merge Cache Outcomes"
    },
    {
      "parameters": {
        "jsCode": "// The cache-miss path already has a correct bucket_file_id (it crossed the\n// Execute Workflow: File Extraction Item sub-workflow boundary and came back\n// self-tagged by that child's own Attach Bucket File ID) -- keep it as-is. Do NOT\n// blindly overwrite via itemMatching() here: pairedItem lineage is not reliable\n// across an Execute Workflow node boundary, and re-deriving it that way previously\n// mis-tagged every item with the same (wrong) id, silently dropping other files.\n// Only the cache-hit path (Check Cache's raw response, straight IF-branch, no\n// sub-workflow crossed) genuinely lacks the field, so itemMatching() is safe there.\nreturn $input.all().map((item, i) => ({\n  json: {\n    ...item.json,\n    bucket_file_id: item.json.bucket_file_id ?? $('When Executed by Another Workflow').itemMatching(i).json.bucket_file_id,\n  },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        128
      ],
      "id": "4e7e931c-84c1-4de3-91b6-4e1951e08958",
      "name": "Ensure Bucket File ID"
    }
  ],
