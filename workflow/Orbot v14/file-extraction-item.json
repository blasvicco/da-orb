      "name": "Handler: Unsupported Format"
    },
    {
      "parameters": {
        "jsCode": "// Merge Extraction Branches (upstream) combines every supported-mime-type branch into\n// one run, so a batch mixing e.g. a CSV and a PDF no longer loses one branch's items to\n// n8n's default \"last unmerged run wins\" behavior on the calling Execute Workflow node.\n// That combined stream can hold rows from several different files at once (a CSV alone\n// already produces one item per row), so group back to one result per source file using\n// pairedItem lineage -- $json no longer carries bucket_file_id by this point (Get Presigned\n// URL / Download File already overwrote it), so recover it from the trigger item itself.\nconst items = $input.all();\nconst groups = new Map();\nfor (let i = 0; i < items.length; i++) {\n  const bucketFileId = $('When Executed by Another Workflow').itemMatching(i).json.bucket_file_id;\n  if (!groups.has(bucketFileId)) groups.set(bucketFileId, { rows: [], indices: [] });\n  const group = groups.get(bucketFileId);\n  group.rows.push(items[i].json);\n  group.indices.push(i);\n}\nreturn Array.from(groups.entries()).map(([bucket_file_id, group]) => ({\n  json: { bucket_file_id, extracted_content: JSON.stringify(group.rows) },\n  pairedItem: group.indices,\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
