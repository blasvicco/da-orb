      "name": "Merge Extraction Outcomes"
    },
    {
      "parameters": {
        "jsCode": "// Neither path into this node carries bucket_file_id as a JSON field (Persist\n// Extraction's PATCH response replaces it; Handler: Unsupported Format never had it) --\n// recover it via pairedItem so the parent (file-extraction-core.json's Merge File\n// Extractions) can match results to bucket_file_ids explicitly instead of by position.\nreturn $input.all().map((item, i) => ({\n  json: {\n    ...item.json,\n    bucket_file_id: $('When Executed by Another Workflow').itemMatching(i).json.bucket_file_id,\n  },\n}));"
      },
      "type": "n8n-nodes-base.code",
