      "name": "Unmatched Route (debug)"
    },
    {
      "parameters": {
        "jsCode": "// Captures the SPINE's own execution id, once, before anything downstream is called --\n// $execution.id inside any called sub-workflow refers to THAT sub-workflow's own\n// (different) execution, so this has to happen here, at the very top, before the first\n// Execute Workflow hop. Injected inside body (not at the top level) since\n// context-enrichment.json's own Enrich Context node is what unwraps the raw webhook\n// envelope via $json.body -- everything after that point reads flat context fields, this\n// is what makes _root_execution_id round-trip the same way as every other field from here\n// on, with no special-casing anywhere downstream. Consumed by response.json's Build\n// Callback Payload, which passes it to Django so the callback handler can, once this\n// entire turn has actually finished, walk the whole execution tree (every nested Execute\n// Workflow hop, chased via each call site's own metadata.subExecution.executionId) and\n// sum the token usage every Chat Model call produced along the way.\nreturn [{ json: { ...$json, body: { ...$json.body, _root_execution_id: $execution.id } } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -832,
        304
      ],
      "id": "e5f8a2c1-9b4d-4e7a-8c1f-3d6b9a0e2f88",
      "name": "Capture Root Execution"
    },
