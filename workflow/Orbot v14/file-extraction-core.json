    {
      "id": "e726b0e1-cdfe-45f4-9fbc-8b22d49e7eef",
      "name": "Split Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        0
      ],
      "parameters": {
        "jsCode": "const base = $json;\nconst ids = base.bucket_file_ids || [];\nreturn ids.map((id) => ({ json: {\n  bucket_file_id: id,\n  org_slug: base.organization?.slug || '',\n  access_token: base.session?.access_token || '',\n} }));"
      }
    },
    {
      "id": "4acefdea-1966-42bf-9e5f-840d9dc6bfd3",
      "name": "Execute Workflow: File Content Extractor",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        320,
        0
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "ozxoh47jtEnWm98N",
          "mode": "id"
        },
        "options": {}
      }
    },
    {
      "id": "0ac41906-1fb2-4bef-ac7d-81f96621c86a",
      "name": "Merge File Extractions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
      ],
      "parameters": {
        "jsCode": "// Match results back to bucket_file_ids by the explicit bucket_file_id field each\n// result now carries (see file-extraction-item.json's Attach Bucket File ID), not by\n// array position -- position broke whenever a batch mixed mime types/outcomes and one\n// branch's items arrived out of the original order (or were lost outright pre-fix).\n// Every downstream caller assumes exactly one item per turn, so this re-merge into a\n// single item carrying the full original turn payload plus extracted_files is required\n// before returning.\nconst originalPayload = $('Execute Workflow Trigger').first().json;\nconst ids = originalPayload.bucket_file_ids || [];\nconst results = $input.all().map((item) => item.json);\nconst byId = new Map(results.map((r) => [r.bucket_file_id, r]));\nconst extractedFiles = ids.map((id) => {\n  const result = byId.get(id);\n  return {\n    bucket_file_id: id,\n    extracted_content: result?.extracted_content ?? null,\n    error: result?.error ?? (result ? null : 'MISSING_EXTRACTION_RESULT'),\n  };\n});\nreturn [{ json: { ...originalPayload, extracted_files: extractedFiles } }];"
      }
    },
    {
      "id": "58043cb6-853c-4ef3-bde8-391b28497d61",
      "name": "No Files: Passthrough",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        272
      ],
      "parameters": {
        "jsCode": "// No files on this turn -- normalizes the contract so callers always see an\n// extracted_files field (null here vs. an array on the has-files path) instead of it\n// being absent on one branch, per \"caller always calls, callee decides whether to no-op\".\nreturn [{ json: { ...$json, extracted_files: null } }];"
      }
    },
    {
      "id": "a50fcbba-9376-499b-a656-42891e2e57a4",
      "name": "Return Extraction Result",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        800,
        128
      ],
      "parameters": {}
    }
  ],
