{
  "node": "Push to Stack + Reset",
  "cases": [
    {
      "description": "pushes the current process onto the stack and resets the active process",
      "input": { "process_id": "p1", "process_definition": { "id": "p1" }, "form_state": { "x": 1 }, "process_stack": [] },
      "expected": {
        "process_id": null,
        "process_definition": null,
        "form_state": null,
        "process_stack": [{ "process_id": "p1", "process_definition": { "id": "p1" }, "form_state": { "x": 1 } }],
        "switch_intent": false,
        "selection_resolved": false,
        "error": null,
        "responde": false
      }
    },
    {
      "description": "does not push an entry when there is no active process_id",
      "input": { "process_id": null, "process_stack": [{ "process_id": "old" }] },
      "expected": { "process_id": null, "process_stack": [{ "process_id": "old" }] }
    },
    {
      "description": "appends to an already non-empty stack",
      "input": { "process_id": "p2", "process_definition": { "id": "p2" }, "form_state": { "y": 2 }, "process_stack": [{ "process_id": "p1" }] },
      "expected": {
        "process_stack": [
          { "process_id": "p1" },
          { "process_id": "p2", "process_definition": { "id": "p2" }, "form_state": { "y": 2 } }
        ]
      }
    },
    {
      "description": "marks the active intention node paused, records its id in paused_node_ids, and clears active_node_id",
      "input": {
        "process_id": "p1", "process_definition": { "id": "p1" }, "form_state": { "x": 1 },
        "process_stack": [], "active_node_id": "p1#0", "paused_node_ids": [],
        "intention_nodes": [{ "id": "p1#0", "parent_id": null, "process_id": "p1", "process_definition": { "id": "p1" }, "form_state": null, "status": "active" }]
      },
      "expected": {
        "active_node_id": null,
        "paused_node_ids": ["p1#0"],
        "intention_nodes": [{ "id": "p1#0", "parent_id": null, "process_id": "p1", "process_definition": { "id": "p1" }, "form_state": { "x": 1 }, "status": "paused" }]
      }
    },
    {
      "description": "leaves paused_node_ids and intention_nodes untouched when there is no active process_id",
      "input": {
        "process_id": null, "process_stack": [{ "process_id": "old" }],
        "paused_node_ids": ["n0"], "intention_nodes": [{ "id": "n0", "status": "paused" }]
      },
      "expected": { "paused_node_ids": ["n0"], "intention_nodes": [{ "id": "n0", "status": "paused" }] }
    }
  ]
}
