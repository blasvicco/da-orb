            "target_field": "FileContnt"
          }
        },
        "_target_form_state": {
          "DocEntry": 45501
        }
      },
      "nodeResults": {},
      "expected": {
        "active_node_id": null,
        "suppress_delivery": true,
        "sap_operation": "CALL_FUNCTION",
        "sap_call_config": {
          "service_name": "SQLQueries",
