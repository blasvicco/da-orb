{
  "node": "Resolve Selection",
  "cases": [
    {
      "description": "passes through unchanged when there are no pending_processes",
      "input": {},
      "nodeResults": { "Parse & Enrich": { "message": "hola", "pending_processes": null } },
      "expected": { "pending_processes": null }
    },
    {
      "description": "resolves a numeric selection to the matching process",
      "input": {},
      "nodeResults": {
        "Parse & Enrich": {
          "message": "1",
          "language": "es",
          "organization": { "slug": "acme" },
          "session": { "database": "TESTDB" },
          "github_owner": "blasvicco",
          "github_repo": "da-sapot-processes",
          "pending_processes": [
            { "name": "Purchase Request", "path": "purchase/purch_request/purch_request.json" },
            { "name": "Sales Order", "path": "sales/sales_order/sales_order.json" }
          ]
        }
      },
      "expected": {
        "standard_path": "purchase/purch_request/purch_request.json",
