{
  "node": "Build SAP Payload",
  "cases": [
    {
      "description": "GET_SINGLE when the query key has a value in form_state, using b1s connection",
      "input": {},
      "nodeResults": {
        "Status Text: Submitting": {
          "process_definition": { "api": { "method": "GET", "service": "BusinessPartners" }, "query": { "key": { "id": "CardCode", "sap_field": "CardCode" } } },
          "form_state": { "CardCode": "C001" },
          "organization": { "integration": { "auth_driver": "b1s", "base_url": "https://sap.example.com" } },
          "session": { "user": { "username": "u", "password": "p" }, "database": "TESTDB" }
        }
      },
      "expected": {
        "sap_operation": "GET_SINGLE",
        "sap_service": "BusinessPartners",
        "sap_payload": null,
        "sap_connection": { "authDriver": "b1s", "baseUrl": "https://sap.example.com", "username": "u", "password": "p", "companyDB": "TESTDB" }
      }
    },
    {
