      "expected": { "state": { "form_state": null, "process_id": null, "process_definition": null, "pending_processes": null, "process_stack": [], "awaiting_stack_resume": false, "reset_process": false, "process_queue": [], "last_bot_message": "Hi", "intention_nodes": [], "active_node_id": null, "paused_node_ids": [], "parent_override_id": null } }
