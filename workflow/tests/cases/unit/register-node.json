{
  "node": "Register Node",
  "cases": [
    {
      "description": "single item, set_active true -> mirrors Initialize Process's old single-match behavior exactly (id minted from prior node count, active_node_id opens the new node)",
      "input": {
        "process_definition": { "id": "purchase_request" },
        "parent_id": null,
        "form_state": {},
        "status": "active",
        "set_active": true,
        "intention_nodes": {},
        "active_node_id": null
      },
      "nodeResults": {},
      "expected": {
        "new_node_id": "purchase_request#0",
        "active_node_id": "purchase_request#0",
        "intention_nodes": {
          "purchase_request#0": {
            "id": "purchase_request#0",
            "parent_id": null,
            "process_id": "purchase_request",
            "process_definition": { "id": "purchase_request" },
            "form_state": {},
            "status": "active",
            "error_detail": null
          }
        }
      }
    },
    {
      "description": "set_active false -> active_node_id left untouched, node still registered; status 'completed' at registration time also prunes process_definition to just {name} -- this node will never re-enter form-filling or SAP execution, only ever get displayed",
      "input": {
        "process_definition": { "id": "vendor_list", "name": "Vendor List" },
        "parent_id": "1#0",
        "form_state": { "CardName": "Flete" },
        "status": "completed",
        "set_active": false,
        "intention_nodes": { "1#0": { "id": "1#0", "status": "active" } },
        "active_node_id": "1#0"
      },
      "nodeResults": {},
      "expected": {
        "new_node_id": "vendor_list#1",
        "active_node_id": "1#0",
        "intention_nodes": {
          "1#0": { "id": "1#0", "status": "active" },
          "vendor_list#1": {
            "id": "vendor_list#1",
            "parent_id": "1#0",
            "process_id": "vendor_list",
            "process_definition": { "name": "Vendor List" },
            "form_state": { "CardName": "Flete" },
            "status": "completed",
            "error_detail": null
          }
        }
      }
    },
    {
      "description": "REGRESSION: status 'paused' at registration time -> process_definition preserved in full, NOT pruned -- a paused node is still resumable (UC-6) and Prompt: Intention Focus reads paused nodes' definitions too, not just the active one",
      "input": {
        "process_definition": { "id": "purchase_request", "name": "Create Purchase Request", "form": { "sections": [] } },
        "parent_id": null,
        "form_state": { "Supplier": "V10000" },
        "status": "paused",
        "set_active": false,
        "intention_nodes": {},
        "active_node_id": null
      },
      "nodeResults": {},
      "expected": {
        "new_node_id": "purchase_request#0",
        "intention_nodes": {
          "purchase_request#0": {
            "id": "purchase_request#0",
            "parent_id": null,
            "process_id": "purchase_request",
            "process_definition": { "id": "purchase_request", "name": "Create Purchase Request", "form": { "sections": [] } },
            "form_state": { "Supplier": "V10000" },
            "status": "paused",
            "error_detail": null
          }
        }
      }
    },
    {
      "description": "a failed batch record carrying error_detail -> persisted verbatim onto the registered node, so a later turn (Prompt: Context & Conversation's lastFailedNode lookup, or the frontend's error popover) has something real to show instead of nothing",
      "input": {
        "process_definition": { "id": "purchase_request" },
        "parent_id": null,
        "form_state": { "CardCode": "V20000", "ready": false },
        "status": "failed",
        "error_detail": "Required date is missing (1)",
        "set_active": false,
        "intention_nodes": {},
        "active_node_id": null
      },
      "nodeResults": {},
      "expected": {
        "new_node_id": "purchase_request#0",
        "intention_nodes": {
          "purchase_request#0": {
            "id": "purchase_request#0",
            "parent_id": null,
            "process_id": "purchase_request",
            "process_definition": { "id": "purchase_request" },
            "form_state": { "CardCode": "V20000", "ready": false },
            "status": "failed",
            "error_detail": "Required date is missing (1)"
          }
        }
      }
    },
    {
      "description": "no error_detail on input (the normal completed/active case) -> defaults to null rather than omitting the key, so every node has a stable, predictable shape",
      "input": {
        "process_definition": { "id": "vendor_list", "name": "Vendor List" },
        "parent_id": null,
        "form_state": {},
        "status": "completed",
        "set_active": false,
        "intention_nodes": {},
        "active_node_id": null
      },
      "nodeResults": {},
      "expected": {
        "intention_nodes": {
          "vendor_list#0": {
            "id": "vendor_list#0",
            "parent_id": null,
            "process_id": "vendor_list",
            "process_definition": { "name": "Vendor List" },
            "form_state": {},
            "status": "completed",
            "error_detail": null
          }
        }
      }
    },
    {
      "description": "REGRESSION: completed node whose process_definition has no name field -> prunes to { name: null } rather than throwing or keeping the full definition",
      "input": {
        "process_definition": { "id": "vendor_list" },
        "parent_id": null,
        "form_state": {},
        "status": "completed",
        "set_active": false,
        "intention_nodes": {},
        "active_node_id": null
      },
      "nodeResults": {},
      "expected": {
        "intention_nodes": {
          "vendor_list#0": {
            "id": "vendor_list#0",
            "parent_id": null,
            "process_id": "vendor_list",
            "process_definition": { "name": null },
            "form_state": {},
            "status": "completed",
            "error_detail": null
          }
        }
      }
    },
    {
      "description": "missing form_state/status/parent_id -> defaults to {}/active/null rather than throwing",
      "input": {
        "process_definition": { "slug": "goods_receipt" },
        "set_active": false,
        "intention_nodes": {}
      },
      "nodeResults": {},
      "expected": {
        "new_node_id": "goods_receipt#0",
        "intention_nodes": {
          "goods_receipt#0": {
            "id": "goods_receipt#0",
            "parent_id": null,
            "process_id": "goods_receipt",
            "process_definition": { "slug": "goods_receipt" },
            "form_state": {},
            "status": "active",
            "error_detail": null
          }
        }
      }
    },
    {
      "description": "REGRESSION: multiple items in one call register sequentially with non-colliding ids -- this is the whole reason a caller must send everything needing registration in ONE call (see Fan Out To Register/Check Registration Needed in batch-processing.json) rather than one call per loop iteration, since splitInBatches doesn't thread mutations across iterations",
      "input": {},
      "inputItems": [
        { "process_definition": { "id": "purch_request" }, "parent_id": null, "form_state": { "a": 1 }, "status": "completed", "set_active": false, "intention_nodes": {} },
        { "process_definition": { "id": "purch_request" }, "parent_id": null, "form_state": { "a": 2 }, "status": "failed", "set_active": false, "intention_nodes": {} },
        { "process_definition": { "id": "vendor_list" }, "parent_id": null, "form_state": {}, "status": "completed", "set_active": false, "intention_nodes": {} }
      ],
      "expectedItems": [
        { "new_node_id": "purch_request#0" },
        { "new_node_id": "purch_request#1" },
        { "new_node_id": "vendor_list#2" }
      ]
    }
  ]
}
