{
  "node": "Normalize Response",
  "cases": [
    {
      "description": "falls back to the base process_id when the update omits it",
      "input": { "message": "hi" },
      "nodeResults": { "Parse & Enrich": { "process_id": "base-p1" } },
      "expected": { "process_id": "base-p1" }
    },
    {
      "description": "uses the update's process_id when it provides one",
      "input": { "process_id": "new-p2" },
      "nodeResults": { "Parse & Enrich": { "process_id": "base-p1" } },
      "expected": { "process_id": "new-p2" }
    },
    {
      "description": "reset_process forces null even if the base had an active process",
      "input": { "reset_process": true },
      "nodeResults": { "Parse & Enrich": { "process_id": "base-p1", "process_definition": { "id": "base-p1" }, "form_state": { "x": 1 } } },
      "expected": { "process_id": null, "process_definition": null, "form_state": null, "reset_process": true }
    },
    {
      "description": "defaults responde to false when the update omits it",
      "input": { "message": "hi" },
      "nodeResults": { "Parse & Enrich": {} },
      "expected": { "responde": false }
    },
    {
      "description": "falls back to the base process_stack and process_queue when the update omits them",
      "input": {},
      "nodeResults": { "Parse & Enrich": { "process_stack": [{ "process_id": "p0" }], "process_queue": [{ "process_id": "q0" }] } },
      "expected": { "process_stack": [{ "process_id": "p0" }], "process_queue": [{ "process_id": "q0" }] }
    },
    {
      "description": "falls back to the base intention_nodes/paused_node_ids/active_node_id when the update omits them",
      "input": {},
      "nodeResults": {
        "Parse & Enrich": {
          "intention_nodes": [{ "id": "n1", "status": "active" }],
          "paused_node_ids": ["n0"],
          "active_node_id": "n1"
        }
      },
      "expected": {
        "intention_nodes": [{ "id": "n1", "status": "active" }],
        "paused_node_ids": ["n0"],
        "active_node_id": "n1"
      }
    },
    {
      "description": "uses the update's intention_nodes/active_node_id when provided",
      "input": { "intention_nodes": [{ "id": "n2", "status": "paused" }], "active_node_id": "n2" },
      "nodeResults": { "Parse & Enrich": { "intention_nodes": [{ "id": "n1", "status": "active" }], "active_node_id": "n1" } },
      "expected": { "intention_nodes": [{ "id": "n2", "status": "paused" }], "active_node_id": "n2" }
    },
    {
      "description": "reset_process forces active_node_id to null even if the base had one",
      "input": { "reset_process": true, "active_node_id": null },
      "nodeResults": { "Parse & Enrich": { "active_node_id": "n1" } },
      "expected": { "active_node_id": null }
    },
    {
      "description": "defaults awaiting_batch_confirmation to false and pending_batch_items to [] when both the update and base omit them",
      "input": { "message": "hi" },
      "nodeResults": { "Parse & Enrich": {} },
      "expected": { "awaiting_batch_confirmation": false, "pending_batch_items": [] }
    },
    {
      "description": "falls back to the base awaiting_batch_confirmation/pending_batch_items when the update omits them",
      "input": { "message": "si" },
      "nodeResults": { "Parse & Enrich": { "awaiting_batch_confirmation": true, "pending_batch_items": [{ "process_name": "Create Purchase Request" }] } },
      "expected": { "awaiting_batch_confirmation": true, "pending_batch_items": [{ "process_name": "Create Purchase Request" }] }
    },
    {
      "description": "uses the update's awaiting_batch_confirmation/pending_batch_items when provided (clearing them once consumed)",
      "input": { "awaiting_batch_confirmation": false, "pending_batch_items": [] },
      "nodeResults": { "Parse & Enrich": { "awaiting_batch_confirmation": true, "pending_batch_items": [{ "process_name": "Create Purchase Request" }] } },
      "expected": { "awaiting_batch_confirmation": false, "pending_batch_items": [] }
    },
    {
      "description": "falls back to the base parent_override_id when the update omits it",
      "input": { "message": "hi" },
      "nodeResults": { "Parse & Enrich": { "parent_override_id": "n0#0" } },
      "expected": { "parent_override_id": "n0#0" }
    },
    {
      "description": "uses the update's parent_override_id when it provides one",
      "input": { "parent_override_id": "n2#0" },
      "nodeResults": { "Parse & Enrich": { "parent_override_id": "n0#0" } },
      "expected": { "parent_override_id": "n2#0" }
    },
    {
      "description": "reset_process forces parent_override_id to null even if the base had one (one-shot consumption)",
      "input": { "reset_process": true, "parent_override_id": null },
      "nodeResults": { "Parse & Enrich": { "parent_override_id": "n0#0" } },
      "expected": { "parent_override_id": null }
    }
  ]
}
