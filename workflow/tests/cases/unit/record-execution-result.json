      "description": "graceful SAP_ERROR -> one failed entry, not a whole-batch abort -- still restores the real intention_nodes/active_node_id from before the synthetic call; error_detail carries the real SAP message forward so it survives to the persisted node (previously dropped here, the root cause of a failed batch record never being retrievable later)",
      "input": {
        "message": "El proveedor no existe",
        "error": "SAP_ERROR",
        "process_definition": { "api": { "method": "GET" } },
        "active_node_id": "batch#purchase/vendor_list.json",
        "intention_nodes": {
          "batch#purchase/vendor_list.json": { "id": "batch#purchase/vendor_list.json", "status": "active", "form_state": { "CardCode": "C001", "ready": false } }
