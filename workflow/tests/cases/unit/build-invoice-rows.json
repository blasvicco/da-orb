        }
      }
    },
    {
      "description": "company_info_source declared but _company_info never arrived (e.g. the SAP call failed and Merge Company Info Result's own fallback also came up empty) -> SREncabDocum simply absent, not a null/empty row -- same 'never simply fails' shape as a missing QR value",
      "input": {
        "_target_form_state": {},
