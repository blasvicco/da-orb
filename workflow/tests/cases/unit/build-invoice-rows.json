    {
      "description": "TaxDetails.rpt: two lines at two different VAT rates -> two rows, BASE/TAX summed independently per rate, CODE derived from the rate itself (never VatGroup -- see next case)",
      "input": {
        "_target_form_state": {
          "VatSum": 420,
          "DocEntry": 45523,
          "DocumentLines": [
            { "LineTotal": 1000, "TaxTotal": 210, "TaxPercentagePerRow": 21 },
            { "LineTotal": 500, "TaxTotal": 210, "TaxPercentagePerRow": 21 },
            { "LineTotal": 1000, "TaxTotal": 0, "TaxPercentagePerRow": 0 }
          ]
        },
        "_target_document_mapping": {
          "header_fields": { "VatSum": "VatSum", "DocEntry": "DocEntry" },
          "line_item_source": "DocumentLines",
          "tax_details_condition_field": "VatSum",
          "tax_details_source": {
            "subreport": "TaxDetails.rpt",
            "line_source": "DocumentLines",
            "rate_field": "TaxPercentagePerRow",
            "code_prefix": "IVA_",
            "base_field": "LineTotal",
            "tax_field": "TaxTotal",
            "dockey_field": "DocEntry"
          }
        }
      },
      "nodeResults": {},
      "expected": {
        "_subreports": {
          "TaxDetails.rpt": {
            "rows": [
              { "DocEntry": 45523, "CODE": "IVA_21", "RATE": 21, "BASE": 1500, "BASEME": 1500, "TAX": 420, "TAXME": 420, "ORIGEN": "" },
              { "DocEntry": 45523, "CODE": "IVA_0", "RATE": 0, "BASE": 1000, "BASEME": 1000, "TAX": 0, "TAXME": 0, "ORIGEN": "" }
            ]
          }
        }
      }
    },
