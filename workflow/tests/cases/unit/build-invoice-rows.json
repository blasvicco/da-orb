{
  "node": "Build Invoice Rows",
  "cases": [
    {
      "description": "a source param resolves from the already-mapped headerRow, not raw form_state -- form_state only ever holds what the user supplied to look the record up (e.g. DocNum), never the entity's own DocEntry the way header_fields' mapping of the fetched entity does; confirmed live this is exactly what silently blanked every rendered row when dockey@ resolved null against form_state",
      "input": {
        "_target_form_state": { "DocNum": 10767, "DocEntry": 45523 },
        "_target_document_mapping": {
          "header_fields": { "DocEntry": "DocEntry" },
          "params": { "dockey@": { "source": "DocEntry" } }
        }
      },
      "nodeResults": {},
      "expected": {
        "_params": { "dockey@": 45523 },
        "_rows": [{ "DocEntry": 45523 }]
      }
    },
    {
      "description": "no qr_source declared -> unchanged from today's behavior, no FileContnt key added even if _qr_value were somehow set",
      "input": {
        "_target_form_state": {},
        "_target_document_mapping": {
          "constants": { "CompnyName": "BVS SA" }
        }
      },
      "nodeResults": {},
      "expected": {
        "_rows": [
          { "CompnyName": "BVS SA" }
        ]
      }
    },
    {
      "description": "qr_source declared and Merge QR Result produced a value -> written onto the header row under qr_source's own target_field, no SAP-field-name literal in this node",
      "input": {
        "_target_form_state": {},
        "_target_document_mapping": {
          "constants": { "CompnyName": "BVS SA" },
          "qr_source": {
            "sql_name": "GetInvoiceQR",
            "key_param": "DocEntry",
            "target_field": "FileContnt"
          }
        },
        "_qr_value": "\\x68656c6c6f"
      },
      "nodeResults": {},
      "expected": {
        "_rows": [
          { "CompnyName": "BVS SA", "FileContnt": "\\x68656c6c6f" }
        ]
      }
    },
    {
      "description": "qr_source declared but Merge QR Result's fetch came back empty/null -> no FileContnt key added (rather than writing a null that would suppress the QR object)",
      "input": {
        "_target_form_state": {},
        "_target_document_mapping": {
          "constants": { "CompnyName": "BVS SA" },
          "qr_source": {
            "sql_name": "GetInvoiceQR",
            "key_param": "DocEntry",
            "target_field": "FileContnt"
          }
        },
        "_qr_value": null
      },
      "nodeResults": {},
      "expected": {
        "_rows": [
          { "CompnyName": "BVS SA" }
        ]
      }
    },
    {
      "description": "section_visibility's {param} marker resolves to the literal boolean the renderer expects (true and false both emitted directly), confirmed live against docs/mockups_flags/*.json",
      "input": {
        "_target_form_state": {},
        "_target_document_mapping": {
          "constants": { "CompnyName": "BVS SA" },
          "params": {
            "ShowEmbeddedLogo@": { "constant": true },
            "ShowEmbeddedAFIP@": { "constant": false }
          },
          "section_visibility": {
            "ReportHeaderSection3": { "param": "ShowEmbeddedLogo@" },
            "ReportHeaderSection4": { "param": "ShowEmbeddedAFIP@" }
          }
        }
      },
      "nodeResults": {},
      "expected": {
        "_section_visibility": { "ReportHeaderSection3": true, "ReportHeaderSection4": false }
      }
    },
    {
      "description": "no section_visibility declared -> defaults to {}, same as every org that doesn't opt in",
      "input": {
        "_target_form_state": {},
        "_target_document_mapping": {
          "constants": { "CompnyName": "BVS SA" }
        }
      },
      "nodeResults": {},
      "expected": {
        "_section_visibility": {}
      }
    },
    {
      "description": "object_visibility's negated {param} marker resolving to false is emitted (an explicit force-hide); a resolution of true is omitted entirely, deferring to the template's own default -- confirmed live against docs/mockups_flags/*.json's embedded-on (all-false, emitted) vs embedded-off ({}, omitted) records",
      "input": {
        "_target_form_state": {},
        "_target_document_mapping": {
          "constants": { "CompnyName": "BVS SA" },
          "params": {
            "ShowEmbeddedLogo@": { "constant": true }
          },
          "object_visibility": {
            "Picture1": { "param": "ShowEmbeddedLogo@", "negate": true },
            "Compania1": { "param": "ShowEmbeddedLogo@", "negate": true }
          }
        }
      },
      "nodeResults": {},
      "expected": {
        "_object_visibility": { "Picture1": false, "Compania1": false }
      }
    },
    {
      "description": "object_visibility's negated {param} marker resolving to true (logo not embedded) is omitted, not sent as true",
      "input": {
        "_target_form_state": {},
        "_target_document_mapping": {
          "constants": { "CompnyName": "BVS SA" },
          "params": {
            "ShowEmbeddedLogo@": { "constant": false }
          },
          "object_visibility": {
            "Picture1": { "param": "ShowEmbeddedLogo@", "negate": true }
          }
        }
      },
      "nodeResults": {},
      "expected": {
        "_object_visibility": {}
      }
    },
    {
      "description": "a params@ flag referenced only by section_visibility/object_visibility is stripped from _params (never a real Crystal Reports parameter); one not referenced that way survives",
      "input": {
        "_target_form_state": {},
        "_target_document_mapping": {
          "constants": { "CompnyName": "BVS SA" },
          "params": {
            "dockey@": { "constant": 45501 },
            "ShowEmbeddedLogo@": { "constant": true }
          },
          "object_visibility": {
            "Picture1": { "param": "ShowEmbeddedLogo@", "negate": true }
          }
        }
      },
      "nodeResults": {},
      "expected": {
        "_params": { "dockey@": 45501 }
      }
    },
    {
      "description": "logo_source declared and Merge Company Info Result produced a _logo_value -> written onto the MAIN header row under logo_source's own target_field (LogoImage), feeding the template's embedded-logo BlobField object -- distinct from and never confused with SREncabDocum's own separate LogoImage field",
      "input": {
        "_target_form_state": {},
        "_target_document_mapping": {
          "constants": { "CompnyName": "BVS SA" },
