    {
      "description": "company_info_source declared and Merge Company Info Result produced _company_info -> written verbatim as SREncabDocum's single row -- this node never re-derives it (SAP-vs-org precedence already resolved upstream)",
      "input": {
        "_target_form_state": {},
        "_target_document_mapping": {
          "constants": { "CompnyName": "BVS SA" },
