        },
        "_company_info": { "CompnyName": "BVS TV SA", "Phone1": "49585638", "E_Mail": "info@bvstv.com", "IntrntAdrs": "www.bvstv.com", "U_B1SYS_VATCtg": "" }
      },
      "nodeResults": {},
      "expected": {
        "_subreports": {
