{
  "path": "sap_inquiry_execution",
  "target_workflow": "sap-inquiry-execution.json",
  "cases": [
    {
      "description": "success, single node with no other node in the graph -> delivers directly, marks the node 'completed'; active_node_id is deliberately left pointing at it (auto-resume-on-completion was removed live 2026-08-15 -- Intent Manager's Park Current Intent now reads active_node_id directly to parent the next request instead). form_state.ready is forced false by Build SAP Payload's own speculative reset (folded in from the old, error-only Reset Form Not Ready node) -- harmless here since a completed node's ready flag is never read again. process_definition is pruned to just {name: null} (no name field on this stub definition) since a completed node never re-enters form-filling or SAP execution.",
      "input": {
        "language": "es",
        "message": "test",
        "group_name": "g1",
        "session_id": "s1",
        "active_node_id": "p1#0",
        "intention_nodes": {
          "p1#0": {
            "id": "p1#0",
            "status": "active",
            "parent_id": null,
            "process_id": "p1",
            "process_definition": {
              "api": { "method": "GET", "service": "BusinessPartners" },
              "query": { "key": { "id": "CardCode", "sap_field": "CardCode" }, "expand": [] }
            },
            "form_state": { "CardCode": "C001" }
          }
        },
        "organization": { "integration": { "auth_driver": "b1s", "base_url": "https://sap.example.com" } },
        "session": { "user": { "username": "u", "password": "p" }, "database": "TESTDB" }
      },
      "pins": {
        "Agent: Execute": { "output": "{\"status\":\"success\",\"message\":\"Aquí está tu resultado\"}" },
        "Status: Submitting": { "status_text": "stub" },
        "Execute Workflow: Response": { "delivered": true }
      },
      "assert": {
        "node": "Compute Execution Outcome",
        "fields": {
          "message": "Aquí está tu resultado",
          "reset_process": true,
          "active_node_id": "p1#0",
          "intention_nodes": {
            "p1#0": {
              "id": "p1#0",
              "status": "completed",
              "parent_id": null,
              "process_id": "p1",
              "process_definition": { "name": null },
              "form_state": { "CardCode": "C001", "ready": false },
              "error_detail": null
            }
          }
        }
      }
    },
    {
      "description": "success on a GET-style inquiry (e.g. a vendor list, even one that returns empty) -> the matching intention node is marked 'completed' rather than left dangling 'active' forever; the parent it interrupted stays exactly 'paused' (no auto-resume, removed live 2026-08-15), active_node_id stays on the just-completed node, and reset_process is set so Django's resettable merge actually applies the change instead of a stale prior value resurfacing on the next turn. process_definition is pruned to {name: null} on the completed child; the still-paused parent's own process_definition is left untouched (it has none set here, but a real one would be preserved in full).",
      "input": {
        "language": "es",
        "message": "test",
        "group_name": "g1",
        "session_id": "s1",
        "active_node_id": "vendor_list#1",
        "intention_nodes": {
          "purchase_request#0": { "id": "purchase_request#0", "status": "paused", "parent_id": null, "process_id": "purchase_request" },
          "vendor_list#1": {
            "id": "vendor_list#1",
            "status": "active",
            "parent_id": "purchase_request#0",
            "process_id": "vendor_list",
            "process_definition": {
              "api": { "method": "GET", "service": "BusinessPartners" },
              "query": { "key": { "id": "CardCode", "sap_field": "CardCode" }, "expand": [] }
            },
            "form_state": { "ready": true }
          }
        },
        "organization": { "integration": { "auth_driver": "b1s", "base_url": "https://sap.example.com" } },
        "session": { "user": { "username": "u", "password": "p" }, "database": "TESTDB" }
      },
      "pins": {
        "Agent: Execute": { "output": "{\"status\":\"success\",\"message\":\"No se encontraron registros.\"}" },
        "Status: Submitting": { "status_text": "stub" },
        "Execute Workflow: Response": { "delivered": true }
      },
      "assert": {
